{
  "name": "@csb/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:wipe": "tsx scripts/wipe-all-data.ts",
    "kb:reembed": "tsx scripts/reembed.ts",
    "gen:cred-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@csb/shared-types": "workspace:*",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@sentry/node": "^10.69.0",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "geoip-lite": "^2.0.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "mammoth": "^1.12.0",
    "minio": "^8.0.7",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-html-parser": "^8.0.2",
    "nodemailer": "^8.0.10",
    "otplib": "^13.4.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.1",
    "winston": "^3.15.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "eslint": "^9",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.4"
  }
}