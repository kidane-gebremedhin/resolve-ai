# ══════════════════════════════════════
# This file is the LOCAL-DEV template (localhost URLs). No host is hardcoded in
# the app source — every URL is read from env. For deployed environments, see the
# per-environment URL templates: .env.development.example, .env.staging.example,
# .env.production.example. NEXT_PUBLIC_*/VITE_* are inlined at BUILD time, so set
# them in each app's build environment; API vars are read at runtime.
# ══════════════════════════════════════

# ══════════════════════════════════════
# API Server (apps/api)
# ══════════════════════════════════════
NODE_ENV=<env>
PORT=<port>
API_BASE_URL=<base-url>
CORS_ORIGINS=<url1, url2>

# Reverse proxies in front of the API (Express `trust proxy`). Controls how much
# of X-Forwarded-For is believed when computing req.ip, which every IP-based
# rate limit depends on. `1` = one proxy (Coolify/nginx/LB) — the usual case.
# Raise only if you really have more hops; a comma-separated list of proxy
# IPs/CIDRs also works. Do NOT set this to `true`: that trusts the whole chain
# and lets clients forge their own source IP to bypass rate limiting.
TRUST_PROXY=1

# Sentry smoke-test endpoints (/api/v1/debug-sentry). They are unauthenticated
# and throw on purpose, so they are OFF in production unless this is "true".
# Outside production they are on by default and this can stay unset.
# DEBUG_ENDPOINTS_ENABLED=false

# Database
MONGODB_URI=<mongo-url>
# REDIS_URL=<redis-url>
# The API container runs `db:migrate` (index sync + data migrations) on startup,
# before the server boots (see apps/api/docker-entrypoint.sh). Set to 1 to skip
# that step for a given boot (e.g. to start the server while migrating by hand).
# SKIP_DB_MIGRATE=1

# Authentication
JWT_SECRET=your-256-bit-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GOOGLE_CLIENT_ID=your-google-client-id
SESSION_TOKEN_EXPIRY_HOURS=1

# AI / LLM
# All AI template params (temperature, thresholds, top-k) are loaded from
# env vars — there are no hardcoded fallbacks in code. Required:
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_BASE_URL=<openrouter-url>
AI_MODEL=<ai-model>
AI_TEMPERATURE=0.2
# Temperature for the operator draft "enhance/polish" pass (lower = closer to draft)
AI_ENHANCE_TEMPERATURE=0.3
# Temperature for the operator reply suggestions endpoint
AI_SUGGESTIONS_TEMPERATURE=0.4
# Below this confidence, the agent escalates instead of replying (0.0–1.0)
AI_CONFIDENCE_THRESHOLD=0.7
# KB vector-search defaults — read by `searchKb()` when callers don't override
AI_KB_SEARCH_TOP_K=8
AI_KB_SEARCH_MIN_SCORE=0.2
# Minimum KB score below which a query is logged as a knowledge gap (default: 0.65)
AI_KB_GAP_SCORE_THRESHOLD=0.65
# Per-attempt timeout (ms) for the OpenRouter chat call; retried on transient errors
AI_LLM_TIMEOUT_MS=30000
# Retries after a transient upstream failure (429 / 5xx / socket reset). Default: 2
AI_LLM_MAX_RETRIES=2
# Hard ceiling on agent<->tool round trips within one customer turn. Default: 10
AI_MAX_TOOL_TURNS=10
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=<embedding-base-url>
# Per-attempt timeout (ms) for the embedding call; retried up to 3x on transient errors
EMBEDDING_TIMEOUT_MS=20000
# Inputs per embedding request — large docs are split into batches of this size
EMBEDDING_BATCH_SIZE=96
# USD per 1M input tokens for the embedding model — used to price embedding usage
# (the provider's response reports tokens but no per-call cost). OpenAI
# text-embedding-3-small is $0.02/1M; adjust for other models/providers.
EMBEDDING_COST_PER_1M_TOKENS=0.02
ENHANCE_MODEL=<enhance-model>

# Pinecone
PINECONE_API_KEY=pc-xxx
PINECONE_INDEX=<index-name>
# PINECONE_ENVIRONMENT=

# Firecrawl
FIRECRAWL_API_KEY=fc-xxx
FIRECRAWL_BASE_URL=<firecrawl-baseurl>
FIRECRAWL_MAX_PAGES=50

# Paddle Billing (server)
# PADDLE_ENVIRONMENT controls which Paddle environment is used end-to-end:
#   sandbox    → test mode; use pdl_sdbx_* API keys, test_* client tokens, sandbox price IDs
#   production → live mode; use pdl_live_* API keys, live_* client tokens, live price IDs
# All Paddle vars (API key, webhook secret, prices, client token) must match this flag.
# Plans: Pro ($70/mo | $588/yr), Business ($199/mo | $1,671.60/yr), Enterprise ($399/mo | $3,351.60/yr)
# Internal keys: pro=Pro, business=Business, enterprise=Enterprise
PADDLE_API_KEY=pdl_xxx
# Signing secret for the PLATFORM billing webhook only (POST /billing/webhook) — the SaaS's
# own subscriptions. NOT used for operator integration callbacks: those are verified with a
# per-connection secret the operator sets in the integrations page.
PADDLE_WEBHOOK_SECRET=pdl_whsec_xxx
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRODUCT_PRO=pro_xxx
PADDLE_PRODUCT_BUSINESS=pro_xxx
PADDLE_PRODUCT_ENTERPRISE=pro_xxx
PADDLE_PRICE_PRO=pri_xxx
PADDLE_PRICE_PRO_YEARLY=pri_xxx
PADDLE_PRICE_BUSINESS=pri_xxx
PADDLE_PRICE_BUSINESS_YEARLY=pri_xxx
PADDLE_PRICE_ENTERPRISE=pri_xxx
PADDLE_PRICE_ENTERPRISE_YEARLY=pri_xxx

# Paddle Billing (client — apps/web, inlined at build time). Must match the
# server PADDLE_ENVIRONMENT + price IDs above.
# Sandbox:    NEXT_PUBLIC_PADDLE_ENV=sandbox,    NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
# Production: NEXT_PUBLIC_PADDLE_ENV=production, NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxx
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRODUCT_PRO=pro_xxx
NEXT_PUBLIC_PADDLE_PRODUCT_BUSINESS=pro_xxx
NEXT_PUBLIC_PADDLE_PRODUCT_ENTERPRISE=pro_xxx
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_YEARLY=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_YEARLY=pri_xxx

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@yourdomain.com
SMTP_SECURE=true

# Where public marketing "Contact Us" form submissions (POST /public/contact) are
# forwarded. Optional — when unset the inquiry is still persisted, only the
# notification email is skipped.
CONTACT_INBOX_EMAIL=hello@yourdomain.com

# Widget attachment content-extraction caps (AI reads uploaded files)
ATTACHMENT_EXTRACT_MAX_CHARS=8000
ATTACHMENT_EXTRACT_MAX_BYTES=5242880

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=<local-path>
# AWS_S3_BUCKET=your-bucket
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_ENDPOINT=

# ══════════════════════════════════════
# Web Dashboard (apps/web)
# ══════════════════════════════════════
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=<>auth-url
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_API_URL=<public-api-url>
NEXT_PUBLIC_SOCKET_URL=<public-socket-url>
NEXT_PUBLIC_WIDGET_URL=<public-widget-url>
NEXT_PUBLIC_EMBED_URL=<public-embed-url>
NEXT_PUBLIC_APP_URL=<public-app-url>

# ---------------------------------------------------------------------------
# Offline RAG evaluation (packages/rag-eval, `pnpm eval:rag`)
# ---------------------------------------------------------------------------
# OpenRouter model id for the LLM-as-judge. Must NOT be the answering model:
# a model grading its own output is not an evaluation. Judge tokens are the
# harness's only inherent spend, and verdicts are cached by answer hash so
# re-runs are near free. Defaults to a strong Claude model when unset.
RAG_EVAL_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Online RAG telemetry (see __specs/39-rag-evaluation.md, "Online telemetry")
# ---------------------------------------------------------------------------
# One `RagTurnMetric` document per customer turn: what retrieval found, what
# generation did with it, and the flags a dashboard groups on. The offline
# harness above scores a fixed golden set; this scores production, which is the
# only place the knowledge base an operator actually wrote gets measured.
#
# ON by default. Every write is fire-and-forget and happens after the reply has
# been persisted and emitted, so it costs a customer nothing. Turn it off only
# if you do not want per-turn analytics stored at all.
RAG_TELEMETRY_ENABLED=true
# TTL on the `ragturnmetrics` collection, in days. Matches the 90 days every
# other per-turn telemetry collection uses (see __specs/12-security-compliance).
RAG_TELEMETRY_RETENTION_DAYS=90

# Share of turns sent to the LLM judge for an online faithfulness score.
#
# 5 percent, because this is a trend line rather than an audit: at a few hundred
# turns a day it moves a rolling average within a day and keeps the judge bill to
# a rounding error against the answering model. The judge runs out of band and is
# skipped entirely for an org that is over its monthly AI budget.
# Set 0 to disable sampling without disabling telemetry; 1 judges every turn.
RAG_FAITHFULNESS_SAMPLE_RATE=0.05
# The judge model. Must NOT be the answering model. Defaults to
# RAG_EVAL_JUDGE_MODEL, then to a strong Claude model, so the online and offline
# faithfulness numbers stay comparable.
RAG_FAITHFULNESS_JUDGE_MODEL=
# The judge runs off the reply path, but it still must not hang a worker.
RAG_FAITHFULNESS_TIMEOUT_MS=20000

# Quality alerts. An org is notified when, over a rolling window, one of the
# three rates crosses its threshold. Each rate alerts separately because each has
# a different fix: no-hit means missing content, low-confidence usually means
# retrieval quality, escalation could be either.
RAG_ALERT_ENABLED=true
RAG_ALERT_WINDOW_MINUTES=60
# Turns required in the window before a rate means anything. Three turns of which
# one missed is not a 33 percent no-hit rate, it is three turns.
RAG_ALERT_MIN_TURNS=20
RAG_ALERT_NO_HIT_RATE=0.4
RAG_ALERT_LOW_CONFIDENCE_RATE=0.3
RAG_ALERT_ESCALATION_RATE=0.5
# Silence per org per rate after one alert, so a bad hour is not a pager storm.
RAG_ALERT_COOLDOWN_MINUTES=360
# How often the background job sweeps orgs with recent traffic.
RAG_ALERT_INTERVAL_MS=900000
# Where the offline harness writes its JSON reports, read by the RAG Quality
# page's eval-history panel. Relative to the API's working directory. A
# deployment shipping only the API has no such directory and the panel simply
# reports none available, which is not an error.
RAG_EVAL_REPORTS_DIR=../../packages/rag-eval/reports

# ---------------------------------------------------------------------------
# Index health (see __specs/04-pinecone-firecrawl.md, "Index health")
# ---------------------------------------------------------------------------
# Turning query logs and thumbs into repairs: which passages earn their place,
# which gaps keep going unanswered, and what an operator does about either.
#
# The READ side (the dashboard panels and the four repair actions) is always on
# and always operator-initiated. What this flag gates is the SCHEDULED half.
#
# OFF by default, deliberately. The scoring has to be watched against real
# traffic before a job is allowed to act on it, and a job that re-embeds
# customer knowledge on a metric nobody has checked is a bad trade. Even on, it
# never deletes and never edits content — it re-embeds drifted sources and
# raises a review notification.
KB_INDEX_HEALTH_ENABLED=false
# The tick is frequent; the WORK is gated to the off-peak hour below, so a
# restart at any time of day cannot miss the window and cannot re-embed during
# business hours either.
KB_INDEX_HEALTH_INTERVAL_MS=1800000
# UTC hour the job may work in. Re-embedding competes with live retrieval for
# the same provider quota.
KB_INDEX_HEALTH_HOUR_UTC=3
# Sources re-embedded per run. A drifted corpus is repaired over several nights
# rather than in one burst that looks like a full reindex to the bill.
KB_INDEX_HEALTH_MAX_REEMBED_PER_RUN=10

# Telemetry window every health metric is computed over.
KB_HEALTH_WINDOW_DAYS=30
# Retrievals a chunk needs before a RATE about it means anything. A chunk
# retrieved twice, once downvoted, is not a 50 percent downvote rate.
KB_HEALTH_MIN_RETRIEVALS=5
# Downvote rate among CITING answers that marks a passage misleading.
KB_HEALTH_DOWNVOTE_RATE=0.3
# Citation rate at or below which a retrieved passage counts as ignored.
KB_HEALTH_UNCITED_RATE=0.2
# Score a passage must reach before "never cited" reads as a chunking defect
# rather than as one that merely scraped into the prompt on a thin query.
KB_HEALTH_STRONG_SCORE=0.5
# Cosine similarity at which two gap queries are the same question.
#
# Measured, not guessed. Swept over a real gap set: 0.86 produced 6 clusters
# from 7 queries (i.e. no clustering at all), 0.75 gave 5, 0.60 gave 4, and 0.55
# finally collapsed the five paraphrases of one question into one row. Raise it
# if unrelated topics start sharing a cluster, lower it if one question keeps
# appearing as several.
KB_HEALTH_GAP_SIMILARITY=0.55

# ---------------------------------------------------------------------------
# Query understanding (see __specs/40-query-understanding.md)
# ---------------------------------------------------------------------------
# Rewrites the search query before it is embedded: resolves follow-ups against
# conversation history, strips filler, fixes typos, expands acronyms, splits
# multi-part questions and generates paraphrases fused with RRF.
#
# DEFAULT OFF, deliberately. It measurably improves retrieval (follow-up MRR
# 0.55 -> 1.00 on the eval fixture set) but costs ~2.5s at p95 on every turn
# that searches the knowledge base, which is 6x the 400ms budget it was
# specified under. Turn it on when that latency is acceptable for your traffic.
AI_QUERY_REWRITE_ENABLED=false
# A small, fast model — NOT the answering model. An OpenRouter model id.
# Measured: haiku-4.5, gemini-2.5-flash-lite and gpt-4o-mini all land at
# 2.5-3.3s p95, so model choice is not what makes this slow.
AI_QUERY_REWRITE_MODEL=anthropic/claude-haiku-4.5
# Rewriting slower than this falls back to the raw query.
AI_QUERY_REWRITE_TIMEOUT_MS=4000
# Prior turns the rewriter sees when resolving a follow-up.
AI_QUERY_REWRITE_HISTORY_TURNS=6
# Paraphrases per query, fused with Reciprocal Rank Fusion. 0 disables expansion.
AI_QUERY_EXPANSION_COUNT=2
# HyDE: embed a hypothetical answer instead of the question. Corpus-dependent.
# Measured on this fixture set: helps where there was headroom (paraphrase MRR
# 0.806 -> 0.889) and does nothing where retrieval was already perfect, at the
# cost of a second model call (~+800ms p95).
AI_QUERY_HYDE_ENABLED=false
# At most ONE extra retrieval round, for multi-hop questions whose second query
# only becomes writable after seeing the first round's results. Never more.
AI_QUERY_FOLLOWUP_ROUND_ENABLED=false

# ---------------------------------------------------------------------------
# Hybrid retrieval (see __specs/41-hybrid-retrieval.md)
# ---------------------------------------------------------------------------
# Dense vectors find passages that MEAN the same thing; a lexical index finds
# passages that CONTAIN the same rare tokens (order ids, error codes, SKUs,
# clause numbers). Neither subsumes the other.
#
# 1.0 = dense only, 0.0 = lexical only. 0.7 is the measured peak of a sweep over
# the eval fixture set, not a guess: Recall@5 1.000 / MRR 0.912, against 0.973 /
# 0.856 at dense-only. Both extremes score worse than the blend.
KB_HYBRID_ALPHA=0.7
# `rrf` fuses on rank, `weighted` on min-max normalised score. RRF is the
# default because a cosine score and a MongoDB $text score are not on comparable
# scales, so blending them raw is meaningless.
KB_HYBRID_FUSION=rrf
# The lexical leg is an enhancement: past this it is dropped and the turn
# proceeds dense-only.
KB_LEXICAL_TIMEOUT_MS=1500
# Prepend the chunk's heading path ("Billing > Refunds > EU") to the embedded
# text. Measured worth: Recall@3 0.932 -> 0.959, MRR 0.892 -> 0.912.
KB_HEADING_PATH_EMBEDDING=true

# ---------------------------------------------------------------------------
# Stage 2: cross-encoder reranking (see __specs/42-reranking.md)
# ---------------------------------------------------------------------------
# Stage 1 (dense + lexical) optimises RECALL and casts wide. Stage 2 reads the
# query and each passage TOGETHER — which a bi-encoder never does — and cuts the
# pool to what actually answers the question.
#
# DEFAULT OFF. Measured on the eval fixture set it is a genuine trade, not a
# clear win: it makes unanswerable questions detectable (0% -> 100% of negative
# cases correctly return no evidence) and costs some recall on answerable ones
# (Recall@5 1.000 -> 0.919). Whether that trade is good depends on whether a
# confident wrong answer is worse for you than a missed source.
KB_RERANK_ENABLED=false
# `pinecone` (hosted cross-encoder) or `llm` (fallback). Prefer pinecone: it is
# an order of magnitude cheaper per call and returns a calibrated score rather
# than a number a language model invented.
KB_RERANK_PROVIDER=pinecone
KB_RERANK_MODEL=bge-reranker-v2-m3
# Stage-1 candidate count. DISTINCT from AI_KB_SEARCH_TOP_K, which is the final
# context size. One setting cannot be both: widening the search would otherwise
# widen the prompt.
KB_RERANK_CANDIDATES=50
# Measured: p50 1155ms / p95 1295ms at 50 candidates. Past this, stage-1
# ordering stands.
KB_RERANK_TIMEOUT_MS=3000
# Relevance floor on the calibrated score, applied to the BEST candidate rather
# than to each one. Filtering per passage drops the second source of every
# multi-hop answer (measured: Recall@5 1.000 -> 0.583). 0.0005 is swept, not
# guessed: this reranker scores the answering passage ~0.5 and everything else
# below 1e-3, so the signal is the gap and not the magnitude.
KB_RERANK_MIN_SCORE=0.0005

# ---------------------------------------------------------------------------
# Grounded prompting (see __specs/43-grounded-prompting.md)
# ---------------------------------------------------------------------------
# Token ceiling for the numbered context block. Enforced by dropping WHOLE
# passages from the bottom of the ranked list, never by truncating one: a
# half-passage is a citation that no longer supports its sentence.
AI_CONTEXT_TOKEN_BUDGET=3000
# Share of factual sentences allowed to carry no citation before the turn's
# confidence is lowered, which lets the existing AI_CONFIDENCE_THRESHOLD
# escalation catch it. This is what makes faithfulness a live control rather
# than a number read in a dashboard afterwards.
#
# 0.5 is deliberately lenient: the sentence classifier is conservative (a
# pleasantry or an honest refusal counts as non-factual), and a tight ratio here
# escalates good replies. Lower it once citation behaviour is measured.
AI_MAX_UNCITED_RATIO=0.5

# ---------------------------------------------------------------------------
# Contradictory knowledge (see __specs/44-knowledge-conflicts.md)
# ---------------------------------------------------------------------------
# When two documents give incompatible answers — an old refund policy and a new
# one, two crawled pages with different prices — both are relevant, both clear
# the score floor, and both reach the prompt. Without this the model picks one,
# blends them, or hedges; blending is the worst, producing a confident answer
# that exists in no document.
#
# Off by default: it adds one model call to turns where a contradiction is
# possible, and the resolution policy changes which answer customers get.
KB_CONFLICT_DETECTION_ENABLED=false
# How close the top two sources must score before a contradiction is even
# considered possible, as a fraction of the leader's score. This is the budget
# gate: a source scoring far below the leader is weaker evidence, not a
# competing claim, and without this nearly every turn would pay for a check.
KB_CONFLICT_SCORE_GAP=0.15

# ---------------------------------------------------------------------------
# Ingestion recovery and alerting (see __specs/04-pinecone-firecrawl.md)
# ---------------------------------------------------------------------------
# Bounded retries for a TRANSIENT failure. Permanent classes (unsupported file
# type, parse failure, no extractable text) consume none at all — retrying an
# image-only PDF produces an image-only PDF.
KB_INGEST_MAX_RETRIES=3
# A source left in `processing` for longer than this was interrupted, almost
# always by the API restarting mid-ingest, and is re-queued. Website sources
# mid-crawl are exempt: they legitimately sit in `processing` for longer.
KB_INGEST_STUCK_PROCESSING_MS=900000
# Base delay for retry backoff, doubled per attempt. Replaces retrying on a flat
# 60s loop, which hammered a rate-limited provider at exactly the rate that got
# us limited in the first place.
KB_INGEST_RETRY_BACKOFF_MS=60000
# Share of an org's sources failing before an operator alert is raised, with a
# floor so a brand-new workspace does not alert on its first bad upload.
KB_INGEST_FAILURE_ALERT_RATE=0.3
KB_INGEST_FAILURE_ALERT_MIN_SOURCES=5example-name.trycloudflare.com
# Optional: server-side (container→container) API base for web/admin server
# components + NextAuth. Falls back to NEXT_PUBLIC_API_URL when unset, so leave it
# blank for `pnpm dev` and proxy-based deploys. docker-compose.full.yml sets it to
# http://api:<port>/api/v1 (compose-network hostname). See RUNBOOK §9.1.
API_INTERNAL_URL=<api-internal-url>
# Internal URL the API uses to reach the web service when proxying Section links
# that point at the app's own domain. Set to http://web:<port> in Docker (avoids
# public-domain routing failures inside the container network). Leave as
# http://localhost:<port> for local development.
WEB_INTERNAL_URL=<web-internal-url>

# ══════════════════════════════════════
# Widget (apps/widget)
# ══════════════════════════════════════
# Uses NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SOCKET_URL from above
# Show the voice-input (mic) button in the widget composer. Read by the API and
# delivered to the widget via /widget/init. Set to "true" to enable; anything
# else (including unset) hides it.
ALLOW_WIDGET_VOICE_INPUT=false

# ══════════════════════════════════════
# Embed (apps/embed)
# ══════════════════════════════════════
VITE_WIDGET_URL=<vite-widget-url>
# API origin the embed loader calls for GET /widget/appearance (defaults to widget origin if unset)
VITE_API_URL=<vite-api-url>
EMBED_BASE_URL=<embed-base-url>

NEXT_PUBLIC_APP_NAME=<public-app-name>
# Override the brand name shown only in the navbar/logo (falls back to NEXT_PUBLIC_APP_NAME).
NEXT_PUBLIC_NAVBAR_BRAND_NAME=
# Per-app NextAuth callback origins for docker-compose.full.yml / Coolify
# (web + admin need DISTINCT public origins). Default to localhost for dev:full.
WEB_NEXTAUTH_URL=<web-url>
ADMIN_NEXTAUTH_URL=<admin-url>

# ══════════════════════════════════════
# Tier 2A — Integration Framework (spec 30)
# ══════════════════════════════════════
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-character hex string (32 bytes for AES-256-GCM). This encrypts ALL
# integration credentials at rest — connection tokens/keys AND per-operator OAuth
# app secrets (see below).
CREDENTIALS_ENCRYPTION_KEY=<64-char-hex>
#
# ── Integration credentials are NO LONGER hardcoded here (Changelog 7) ──
# Every operator maintains their own tool connections in-app, encrypted at rest:
#   • Provider API keys (Cal.com, Shopify, Paddle integration, custom webhooks) are
#     entered per-connection in the Integrations UI and stored encrypted — there is
#     no CALCOM_API_KEY / etc. in the environment.
#   • OAuth *app* credentials (Atlassian/Jira, Calendly, Linear, Shopify, Stripe
#     client_id/client_secret) are configured per-organization under each connector's
#     "Configure OAuth app" — stored encrypted, not in this file. Each operator
#     registers their own OAuth app with the provider.
# Existing deployments: run `pnpm --filter @csb/api integrations:migrate-oauth-apps`
# to copy any legacy <PROVIDER>_CLIENT_ID/_CLIENT_SECRET values into the encrypted
# per-org store BEFORE deleting them, so live connections keep refreshing.
#
# Custom webhook connector timeout (ms)
# WEBHOOK_TIMEOUT_MS=10000
# Display allow-list for the integrations page: comma-separated provider ids to show; all others
# are hidden. Display/filtering only — does not affect connect/execute or existing connections.
# Case-insensitive, whitespace-trimmed; unknown ids are ignored. Unset/empty = show all.
# Valid ids: calcom, calendly, stripe, shopify, linear, jira, paddle, webhook
# INTEGRATION_ALLOWED_TOOLS=jira,stripe,webhook
# Identity-verification OTP time-to-live, in seconds. Default 600 = 10 minutes. The OTP
# email tells the customer how long the code is valid, derived from this value.
# OTP_EXPIRY_SECONDS=600

# ══════════════════════════════════════
# Tier 2B — Agentic Tools (spec 31)
# ══════════════════════════════════════

# ══════════════════════════════════════
# Tier 3 — Rich Messages (spec 32)
# ══════════════════════════════════════
# Model for vision requests on image attachments (defaults to AI_MODEL if unset)
# AI_VISION_MODEL=openai/gpt-4o
# Max image size (bytes) before resizing for the vision API (default: 4 MB)
# AI_VISION_MAX_IMAGE_BYTES=4194304


# ══════════════════════════════════════
# Tier 5 — Trust & Compliance (spec 34)
# ══════════════════════════════════════
# Per-session widget message rate limit (defaults: 30 msg / 60 s)
# WIDGET_RATE_LIMIT_MAX=30
# WIDGET_RATE_LIMIT_WINDOW_MS=60000
# Abuse detection: JSON array of regex pattern strings (default: built-in prompt-injection patterns)
# ABUSE_PATTERNS=["ignore previous instructions","act as a different ai"]

# ══════════════════════════════════════
# Tier 6 — Voice (spec 34)
# ══════════════════════════════════════
# STT (Speech-to-Text) — defaults to OpenAI Whisper.
# Set STT_API_KEY to your OpenAI key (or reuse OPENAI_API_KEY).
# STT_API_KEY=sk-xxx
# STT_BASE_URL=https://api.openai.com/v1
# TTS (Text-to-Speech) — defaults to OpenAI TTS.
# TTS_API_KEY is required for /tts endpoint (can be same key as STT_API_KEY).
TTS_API_KEY=sk-xxx
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Twilio phone bridge (optional — only needed for phone channel)
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=   # REQUIRED for the phone bridge: POST /voice/twiml
#                      # verifies Twilio's X-Twilio-Signature with it and
#                      # refuses the webhook (503) when it is unset.
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ══════════════════════════════════════
# Error Monitoring — Sentry (spec 35)
# ══════════════════════════════════════
# Every Sentry var is OPTIONAL, so they stay commented out here (an uncommented
# key in this file is treated as required by `pnpm verify:env`). With no DSN the
# SDKs never initialise, every Sentry call is a no-op, and both apps run exactly
# as before. Uncomment what you need per environment.
#
# API (apps/api) — read at RUNTIME, so a change only needs a restart.
# Backend project DSN.
# SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project-id>
# Environment tag on every event (development / staging / production).
# Falls back to NODE_ENV when unset.
# SENTRY_ENVIRONMENT=development
# Build identifier (usually the git SHA) so a stack trace maps to a known build.
# SENTRY_RELEASE=
#
# Web (apps/web) — NEXT_PUBLIC_* is inlined into the client bundle at BUILD time,
# so it must be passed as a docker build arg (see apps/web/Dockerfile). Setting it
# only at runtime leaves the browser SDK uninitialised while server errors keep
# reporting — the failure mode looks like "Sentry works", so double-check this one.
# Frontend project DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project-id>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
#
# Source-map upload (build time). Without SENTRY_AUTH_TOKEN the build still
# succeeds — production stack traces just stay minified.
# SENTRY_ORG=mllabs-xk
# SENTRY_PROJECT=addisaipro-frontend
# SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_SUPPORT_PHONE=+1xxxxxxxxxx
NEXT_PUBLIC_SUPPORT_ADDRESS=xyz..
# Lifetime-deal (LTD) coupons
# When true, "unknown code" and "code is deactivated" return the SAME message on
# POST /coupons/validate|redeem, so the endpoint can't be used to enumerate which
# codes are real. Costs you support clarity ("is my code wrong or switched off?"),
# so it's off by default; rate limiting is the primary brute-force defence either
# way. Set true for a high-value public campaign.
# COUPON_MASK_UNKNOWN_CODES=false


# ══════════════════════════════════════
# LangSmith tracing (spec 05) — OPTIONAL
# ══════════════════════════════════════
# Traces every LangGraph node, LLM call and tool call for the AI agent.
# OFF by default: tracing ships conversation content (including customer
# messages) to LangSmith, so it must be an explicit opt-in. Requires BOTH LANGSMITH_TRACING=true and a non-empty LANGSMITH_API_KEY.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=customer-service-chatbot
