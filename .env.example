# ══════════════════════════════════════
# This file is the LOCAL-DEV template (localhost URLs). No host is hardcoded in
# the app source — every URL is read from env. For deployed environments, see the
# per-environment URL templates: .env.development.example, .env.staging.example,
# .env.production.example. NEXT_PUBLIC_*/VITE_* are inlined at BUILD time, so set
# them in each app's build environment; API vars are read at runtime.
# ══════════════════════════════════════

# ══════════════════════════════════════
# API Server (apps/api)
# ══════════════════════════════════════
NODE_ENV=<env>
PORT=<port>
API_BASE_URL=<base-url>
CORS_ORIGINS=<url1, url2>

# Database
MONGODB_URI=<mongo-url>
# REDIS_URL=<redis-url>

# Authentication
JWT_SECRET=your-256-bit-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GOOGLE_CLIENT_ID=your-google-client-id
SESSION_TOKEN_EXPIRY_HOURS=1

# AI / LLM
# All AI template params (temperature, thresholds, top-k) are loaded from
# env vars — there are no hardcoded fallbacks in code. Required:
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_BASE_URL=<openrouter-url>
AI_MODEL=<ai-model>
AI_TEMPERATURE=0.2
# Temperature for the operator draft "enhance/polish" pass (lower = closer to draft)
AI_ENHANCE_TEMPERATURE=0.3
# Temperature for the operator reply suggestions endpoint
AI_SUGGESTIONS_TEMPERATURE=0.4
# Below this confidence, the agent escalates instead of replying (0.0–1.0)
AI_CONFIDENCE_THRESHOLD=0.7
# KB vector-search defaults — read by `searchKb()` when callers don't override
AI_KB_SEARCH_TOP_K=8
AI_KB_SEARCH_MIN_SCORE=0.2
# Minimum KB score below which a query is logged as a knowledge gap (default: 0.65)
AI_KB_GAP_SCORE_THRESHOLD=0.65
# Per-attempt timeout (ms) for the OpenRouter chat call; retried up to 3x on transient errors
AI_LLM_TIMEOUT_MS=30000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=<embedding-base-url>
# Per-attempt timeout (ms) for the embedding call; retried up to 3x on transient errors
EMBEDDING_TIMEOUT_MS=20000
# Inputs per embedding request — large docs are split into batches of this size
EMBEDDING_BATCH_SIZE=96
ENHANCE_MODEL=<enhance-model>

# Pinecone
PINECONE_API_KEY=pc-xxx
PINECONE_INDEX=<index-name>
# PINECONE_ENVIRONMENT=

# Firecrawl
FIRECRAWL_API_KEY=fc-xxx
FIRECRAWL_BASE_URL=<firecrawl-baseurl>
FIRECRAWL_MAX_PAGES=50

# Paddle Billing (server)
# PADDLE_ENVIRONMENT controls which Paddle environment is used end-to-end:
#   sandbox    → test mode; use pdl_sdbx_* API keys, test_* client tokens, sandbox price IDs
#   production → live mode; use pdl_live_* API keys, live_* client tokens, live price IDs
# All Paddle vars (API key, webhook secret, prices, client token) must match this flag.
# Plans: Pro ($70/mo | $588/yr), Business ($199/mo | $1,671.60/yr), Enterprise ($399/mo | $3,351.60/yr)
# Internal keys: pro=Pro, business=Business, enterprise=Enterprise
PADDLE_API_KEY=pdl_xxx
PADDLE_WEBHOOK_SECRET=pdl_whsec_xxx
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRODUCT_PRO=pro_xxx
PADDLE_PRODUCT_BUSINESS=pro_xxx
PADDLE_PRODUCT_ENTERPRISE=pro_xxx
PADDLE_PRICE_PRO=pri_xxx
PADDLE_PRICE_PRO_YEARLY=pri_xxx
PADDLE_PRICE_BUSINESS=pri_xxx
PADDLE_PRICE_BUSINESS_YEARLY=pri_xxx
PADDLE_PRICE_ENTERPRISE=pri_xxx
PADDLE_PRICE_ENTERPRISE_YEARLY=pri_xxx

# Paddle Billing (client — apps/web, inlined at build time). Must match the
# server PADDLE_ENVIRONMENT + price IDs above.
# Sandbox:    NEXT_PUBLIC_PADDLE_ENV=sandbox,    NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
# Production: NEXT_PUBLIC_PADDLE_ENV=production, NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxx
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRODUCT_PRO=pro_xxx
NEXT_PUBLIC_PADDLE_PRODUCT_BUSINESS=pro_xxx
NEXT_PUBLIC_PADDLE_PRODUCT_ENTERPRISE=pro_xxx
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_YEARLY=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_YEARLY=pri_xxx

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@yourdomain.com
SMTP_SECURE=false

# Widget attachment content-extraction caps (AI reads uploaded files)
ATTACHMENT_EXTRACT_MAX_CHARS=8000
ATTACHMENT_EXTRACT_MAX_BYTES=5242880

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=<local-path>
# AWS_S3_BUCKET=your-bucket
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_ENDPOINT=

# ══════════════════════════════════════
# Web Dashboard (apps/web)
# ══════════════════════════════════════
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=<>auth-url
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_API_URL=<public-api-url>
NEXT_PUBLIC_SOCKET_URL=<public-socket-url>
NEXT_PUBLIC_WIDGET_URL=<public-widget-url>
NEXT_PUBLIC_EMBED_URL=<public-embed-url>
NEXT_PUBLIC_APP_URL=<public-app-url>
# Optional: server-side (container→container) API base for web/admin server
# components + NextAuth. Falls back to NEXT_PUBLIC_API_URL when unset, so leave it
# blank for `pnpm dev` and proxy-based deploys. docker-compose.full.yml sets it to
# http://api:<port>/api/v1 (compose-network hostname). See RUNBOOK §9.1.
API_INTERNAL_URL=<api-internal-url>
# Internal URL the API uses to reach the web service when proxying Section links
# that point at the app's own domain. Set to http://web:<port> in Docker (avoids
# public-domain routing failures inside the container network). Leave as
# http://localhost:<port> for local development.
WEB_INTERNAL_URL=<web-internal-url>

# ══════════════════════════════════════
# Widget (apps/widget)
# ══════════════════════════════════════
# Uses NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SOCKET_URL from above
# Show the voice-input (mic) button in the widget composer. Read by the API and
# delivered to the widget via /widget/init. Set to "true" to enable; anything
# else (including unset) hides it.
ALLOW_WIDGET_VOICE_INPUT=false

# ══════════════════════════════════════
# Embed (apps/embed)
# ══════════════════════════════════════
VITE_WIDGET_URL=<vite-widget-url>
# API origin the embed loader calls for GET /widget/appearance (defaults to widget origin if unset)
VITE_API_URL=<vite-api-url>
EMBED_BASE_URL=<embed-base-url>

NEXT_PUBLIC_APP_NAME=<public-app-name>
# Override the brand name shown only in the navbar/logo (falls back to NEXT_PUBLIC_APP_NAME).
NEXT_PUBLIC_NAVBAR_BRAND_NAME=
# Per-app NextAuth callback origins for docker-compose.full.yml / Coolify
# (web + admin need DISTINCT public origins). Default to localhost for dev:full.
WEB_NEXTAUTH_URL=<web-url>
ADMIN_NEXTAUTH_URL=<admin-url>

# ══════════════════════════════════════
# Tier 2A — Integration Framework (spec 30)
# ══════════════════════════════════════
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-character hex string (32 bytes for AES-256-GCM). This encrypts ALL
# integration credentials at rest — connection tokens/keys AND per-operator OAuth
# app secrets (see below).
CREDENTIALS_ENCRYPTION_KEY=<64-char-hex>
#
# ── Integration credentials are NO LONGER hardcoded here (Changelog 7) ──
# Every operator maintains their own tool connections in-app, encrypted at rest:
#   • Provider API keys (Cal.com, Shopify, Paddle integration, custom webhooks) are
#     entered per-connection in the Integrations UI and stored encrypted — there is
#     no CALCOM_API_KEY / etc. in the environment.
#   • OAuth *app* credentials (Atlassian/Jira, Calendly, Linear, Shopify, Stripe
#     client_id/client_secret) are configured per-organization under each connector's
#     "Configure OAuth app" — stored encrypted, not in this file. Each operator
#     registers their own OAuth app with the provider.
# Existing deployments: run `pnpm --filter @csb/api integrations:migrate-oauth-apps`
# to copy any legacy <PROVIDER>_CLIENT_ID/_CLIENT_SECRET values into the encrypted
# per-org store BEFORE deleting them, so live connections keep refreshing.
#
# Custom webhook connector timeout (ms)
# WEBHOOK_TIMEOUT_MS=10000
# OTP_EXPIRY_SECONDS=600

# ══════════════════════════════════════
# Tier 2B — Agentic Tools (spec 31)
# ══════════════════════════════════════

# ══════════════════════════════════════
# Tier 3 — Rich Messages (spec 32)
# ══════════════════════════════════════
# Model for vision requests on image attachments (defaults to AI_MODEL if unset)
# AI_VISION_MODEL=openai/gpt-4o
# Max image size (bytes) before resizing for the vision API (default: 4 MB)
# AI_VISION_MAX_IMAGE_BYTES=4194304


# ══════════════════════════════════════
# Tier 5 — Trust & Compliance (spec 34)
# ══════════════════════════════════════
# Per-session widget message rate limit (defaults: 30 msg / 60 s)
# WIDGET_RATE_LIMIT_MAX=30
# WIDGET_RATE_LIMIT_WINDOW_MS=60000
# Abuse detection: JSON array of regex pattern strings (default: built-in prompt-injection patterns)
# ABUSE_PATTERNS=["ignore previous instructions","act as a different ai"]

# ══════════════════════════════════════
# Tier 6 — Voice (spec 34)
# ══════════════════════════════════════
# STT (Speech-to-Text) — defaults to OpenAI Whisper.
# Set STT_API_KEY to your OpenAI key (or reuse OPENAI_API_KEY).
# STT_API_KEY=sk-xxx
# STT_BASE_URL=https://api.openai.com/v1
# TTS (Text-to-Speech) — defaults to OpenAI TTS.
# TTS_API_KEY is required for /tts endpoint (can be same key as STT_API_KEY).
TTS_API_KEY=sk-xxx
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Twilio phone bridge (optional — only needed for phone channel)
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
