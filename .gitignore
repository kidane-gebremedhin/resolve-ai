# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# vendored template (not part of the app)
nextsaas/

# build artifacts
.next/
out/
dist/
build/

# turbo
.turbo/

# testing
coverage/

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (opt-in commit via !.env.example)
.env
.env.*
!.env.example
.envbkp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# certs
certs/

# uploads (local file storage)
uploads/

# Country-flag SVGs vendored from node_modules at build time by
# apps/widget/scripts/copy-flags.mjs — generated, not authored.
apps/widget/public/flags/

# NOTE: CHANGELOG_*.md, QA_TEST_RESULTS_*.md and IMPLEMENTATION_AUDIT.md were
# ignored here. Being untracked, they did not survive a clean — CHANGELOG_1
# through 3 and every QA_TEST_RESULTS file were lost that way. A record of why a
# decision was made is worth more than the diff that made it, so they are tracked
# now. Re-ignore them only if you also decide the history is disposable.

.claude

.envrc
.nvmrc

BLOCKERS.md

test-data.md

# apps.sh runtime dir (PIDs + logs)
.run/

.playwright-mcp

